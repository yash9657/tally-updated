# syntax=docker/dockerfile:1
#
# insightd on Vercel (Container Runtime). OPTIONAL service: it backs the Bill
# Inbox (document -> purchase-voucher DRAFT) and is reached ONLY through cored's
# draft proxy. Vercel builds this when the project's Root Directory is
# `insightd`; see docs/DEPLOY_VERCEL.md.
#
# requirements-deploy.txt locks the core runtime, durable PostgreSQL draft
# store and Anthropic adapters together. NOT installed: real OCR (paddleocr/paddlepaddle, multi-GB
# and CPU-heavy) and Presidio. With no INSIGHTD_USE_REAL_* flags set every stage
# runs its deterministic fake.
#
# Serves HTTP on $PORT; the project MUST set PORT=8080 (non-root image).

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-deploy.txt ./
RUN pip install -r requirements-deploy.txt
COPY insightd ./insightd
RUN useradd --system --uid 10001 app
USER app
ENV PORT=8080
EXPOSE 8080
# exec so uvicorn is PID 1 and receives SIGTERM (graceful shutdown).
CMD ["sh", "-c", "exec uvicorn insightd.api.app:app --host 0.0.0.0 --port ${PORT} --proxy-headers --timeout-graceful-shutdown 25"]
