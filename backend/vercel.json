{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cored": { "root": "./", "entrypoint": "Dockerfile.vercel", "runtime": "container" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "cored" } }],
  "crons": [
    { "path": "/internal/cron/tick", "schedule": "0 * * * *" },
    { "path": "/internal/cron/anchor", "schedule": "30 21 * * *" }
  ]
}
