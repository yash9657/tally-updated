{
  "schema": "nic-einvoice-subset",
  "version": "1.1",
  "description": "Recorded subset of the NIC e-invoice (IRN) schema. Hand-derived golden used by ValidateEInvoice. Not a full JSON-Schema; the validator in schema.go reads these constants.",
  "doc_types": ["INV", "CRN", "DBN"],
  "supply_types": ["B2B", "SEZWP", "SEZWOP", "EXPWP", "EXPWOP", "DEXP"],
  "tax_schemes": ["GST"],
  "gstin": {
    "length": 15,
    "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
  },
  "state_code": {
    "length_min": 1,
    "length_max": 2
  },
  "decimal_places": 2,
  "item_list": {
    "min": 1,
    "max": 1000
  },
  "max_lengths": {
    "DocDtls.No": 16,
    "PartyDtls.LglNm": 100,
    "PartyDtls.Addr1": 100,
    "PartyDtls.Loc": 50,
    "EInvoiceItem.PrdDesc": 300,
    "EInvoiceItem.HsnCd": 8
  },
  "required_sections": ["Version", "TranDtls", "DocDtls", "SellerDtls", "BuyerDtls", "ItemList", "ValDtls"],
  "required_fields": {
    "DocDtls": ["Typ", "No", "Dt"],
    "SellerDtls": ["Gstin", "LglNm", "Stcd"],
    "BuyerDtls": ["Gstin", "LglNm", "Pos"],
    "ValDtls": ["AssVal", "TotInvVal"]
  }
}
