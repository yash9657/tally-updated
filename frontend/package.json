{
  "name": "tally-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tallyweb — keyboard-first accounting, inventory, and AI-assisted workflows for the web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e:edit": "tsx scripts/e2e-edit-loop.mts",
    "e2e:alter": "tsx scripts/e2e-edit-loop.mts",
    "e2e:numbering": "tsx scripts/e2e-numbering.mts",
    "e2e:state-code": "tsx scripts/e2e-state-code.mts",
    "e2e:ocr": "tsx scripts/e2e-ocr-prefill.mts",
    "e2e:ui": "node scripts/e2e-ui-smoke.mjs",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "verify:demo": "tsx scripts/verify-demo.mts",
    "seed:tenancy": "tsx scripts/seed-tenancy.mts",
    "verify:tenancy": "tsx scripts/verify-tenancy.mts",
    "contract:cored": "tsx scripts/contract-mock-vs-cored.mts"
  },
  "dependencies": {
    "@xstate/react": "^4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
